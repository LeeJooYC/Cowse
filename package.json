{
  "name": "cowse-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["sdk/packages/*", "apps/cli", "apps/cline-hub", "apps/cline-hub/src/webview", "apps/examples/cowse-app"],
  "scripts": {
    "build:sdk": "bun --production -F './sdk/packages/*' build",
    "dev": "bun -F @cowse/desktop dev",
    "dev:headless": "bun -F @cowse/desktop dev:headless",
    "build": "bun run build:sdk && bun -F @cowse/desktop build",
    "package:mac": "bun run build:sdk && bun -F @cowse/desktop package:desktop:mac",
    "typecheck": "bun -F @cowse/desktop typecheck",
    "test:chat-ui": "bun -F @cowse/desktop test:chat-ui",
    "cli": "bun --conditions=development --cwd apps/cli dev"
  },
  "engines": { "bun": "1.3.13", "node": ">=22" },
  "packageManager": "bun@1.3.13",
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.3.5",
    "vitest": "^4.0.18"
  },
  "peerDependencies": { "nanoid": "^5.1.7", "typescript": "^5.9.3" },
  "overrides": {
    "axios": "1.18.0",
    "fast-uri": ">=3.1.4",
    "undici@>=6.0.0 <7.0.0": "6.28.0",
    "@opentui/core": "0.4.3",
    "@opentui/react": "0.4.3",
    "tar-fs": ">=3.1.1",
    "tar": "^7.5.2",
    "js-yaml": "^4.1.1",
    "serialize-javascript": ">=7.0.3",
    "protobufjs": "7.6.5",
    "mermaid": "11.16.1",
    "diff": "8.0.4",
    "@sap-cloud-sdk/connectivity": "4.6.0",
    "@sap-cloud-sdk/http-client": "4.6.0",
    "@sap-cloud-sdk/openapi": "4.6.0",
    "@sap-cloud-sdk/resilience": "4.6.0",
    "@sap-cloud-sdk/util": "4.6.0"
  },
  "trustedDependencies": ["better-sqlite3", "grpc-tools"],
  "patchedDependencies": {
    "@opentui-ui/dialog@0.1.2": "patches/@opentui-ui%2Fdialog@0.1.2.patch",
    "ollama-ai-provider-v2@4.0.1": "patches/ollama-ai-provider-v2@4.0.1.patch"
  }
}
